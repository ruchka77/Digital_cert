<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>DigitalCertHelper</RootNamespace>
    <AssemblyName>DigitalCertHelper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Digital Certificate Renewal Helper</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- "dotnet publish" uses this profile by default; build, test and F5 are not affected. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true' and '$(PublishProfile)' == ''">
    <PublishProfile>win-x64-self-contained</PublishProfile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- System.DirectoryServices ships with the Windows Desktop runtime; no package is needed. -->
    <!-- Compile-time only: the COM types used are embedded (see target below). NU1701: the PIA targets .NET Framework. -->
    <PackageReference Include="Microsoft.Office.Interop.Outlook" Version="15.0.4797.1004"
                      ExcludeAssets="runtime" PrivateAssets="all" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in defaults. A file named appsettings.json beside the executable replaces them. -->
    <EmbeddedResource Include="appsettings.json" LogicalName="appsettings.json" />
    <InternalsVisibleTo Include="DigitalCertHelper.Tests" />
  </ItemGroup>

  <!-- Embed the interop types so that no Office PIA has to be installed on the workstation. -->
  <Target Name="EmbedOutlookInterop" AfterTargets="ResolveReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <ReferencePath Condition="'%(Filename)' == 'Microsoft.Office.Interop.Outlook'">
        <EmbedInteropTypes>true</EmbedInteropTypes>
      </ReferencePath>
    </ItemGroup>
  </Target>

</Project>
