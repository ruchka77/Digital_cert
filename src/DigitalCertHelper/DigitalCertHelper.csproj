<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>DigitalCertHelper</RootNamespace>
    <AssemblyName>DigitalCertHelper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Digital Certificate Renewal Helper</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- System.DirectoryServices ships with the Windows Desktop runtime; no package is needed. -->
    <!-- Compile-time only: the COM types used are embedded (see target below). NU1701: the PIA targets .NET Framework. -->
    <PackageReference Include="Microsoft.Office.Interop.Outlook" Version="15.0.4797.1004"
                      ExcludeAssets="runtime" PrivateAssets="all" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <InternalsVisibleTo Include="DigitalCertHelper.Tests" />
  </ItemGroup>

  <!-- Embed the interop types so that no Office PIA has to be installed on the workstation. -->
  <Target Name="EmbedOutlookInterop" AfterTargets="ResolveReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <ReferencePath Condition="'%(Filename)' == 'Microsoft.Office.Interop.Outlook'">
        <EmbedInteropTypes>true</EmbedInteropTypes>
      </ReferencePath>
    </ItemGroup>
  </Target>

</Project>
