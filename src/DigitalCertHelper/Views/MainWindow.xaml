<Window x:Class="DigitalCertHelper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="בקשת חידוש תעודה דיגיטלית"
        Width="760" Height="620" MinWidth="600" MinHeight="520"
        FlowDirection="RightToLeft" xml:lang="he-IL"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- "Display Name (National ID)"; the ID is always left-to-right. -->
        <DataTemplate x:Key="UserTemplate">
            <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding DisplayName}">
                <TextBlock Text="{Binding DisplayName}" />
                <TextBlock Text="{Binding NationalId, StringFormat=({0})}" FlowDirection="LeftToRight" Margin="6,0,0,0" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="1. קובץ לצירוף" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Style="{StaticResource PrimaryButton}" Grid.RowSpan="2" Content="בחר קובץ" Padding="12,4" Margin="0,0,12,0" VerticalAlignment="Top"
                        Command="{Binding SelectCertificateCommand}"
                        ToolTip="בחירת הקובץ שיצורף להודעה (כל סוג קובץ)" />
                <TextBlock Grid.Column="1" Text="שם הקובץ:" Margin="0,0,8,4" />
                <TextBox Grid.Column="2" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FlowDirection="LeftToRight" TextAlignment="Right" Margin="0,0,0,4"
                         Text="{Binding Certificate.FileName, Mode=OneWay}"
                         AutomationProperties.Name="שם הקובץ" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="נתיב מלא:" Margin="0,0,8,0" />
                <TextBox Grid.Row="1" Grid.Column="2" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FlowDirection="LeftToRight" TextAlignment="Right" TextWrapping="Wrap"
                         Text="{Binding Certificate.FullPath, Mode=OneWay}"
                         AutomationProperties.Name="נתיב מלא" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding Certificate.MayContainPrivateKey, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"
                           Text="אזהרה: הקובץ עשוי להכיל מפתח פרטי. ודא שמותר לשלוח אותו בדואר אלקטרוני." />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="2. חיפוש משתמש" Padding="6" Margin="0,8,0,0"
                  IsEnabled="{Binding IsSearchEnabled}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="הזן שם פרטי או שם משפחה של המשתמש:" Target="{Binding ElementName=SearchBox}" Padding="0,0,0,4" />
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" MaxLength="64" Padding="3"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnSearchBoxKeyDown"
                             ToolTip="הקלד לפחות 3 תווים כדי לקבל הצעות, או לחץ על 'חיפוש'" />
                    <Button Style="{StaticResource PrimaryButton}" Grid.Column="1" Content="חיפוש" Padding="12,3" Margin="8,0,0,0"
                            Command="{Binding SearchCommand}" ToolTip="חיפוש משתמש ב-Active Directory" />
                    <Popup StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=SearchBox}"
                           Width="{Binding ActualWidth, ElementName=SearchBox}"
                           IsOpen="{Binding IsSuggestionsOpen, Mode=TwoWay}">
                        <ListBox x:Name="SuggestionList" MaxHeight="300" FlowDirection="RightToLeft"
                                 ItemsSource="{Binding Suggestions}" ItemTemplate="{StaticResource UserTemplate}"
                                 AutomationProperties.Name="הצעות למשתמשים"
                                 PreviewKeyDown="OnSuggestionKeyDown"
                                 PreviewMouseLeftButtonUp="OnSuggestionClick" />
                    </Popup>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Results}"
                          SelectedItem="{Binding HighlightedUser, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          SelectionUnit="FullRow" CanUserSortColumns="True" CanUserAddRows="False"
                          HeadersVisibility="Column" MinHeight="90"
                          AutomationProperties.Name="תוצאות החיפוש"
                          MouseDoubleClick="OnGridDoubleClick" PreviewKeyDown="OnGridKeyDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="שם תצוגה" Binding="{Binding DisplayName}" Width="2*" />
                        <DataGridTextColumn Header="תעודת זהות" Binding="{Binding NationalId}" Width="*" />
                        <DataGridTextColumn Header="מחלקה" Binding="{Binding Department}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="המשתמש שנבחר:" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"
                               Visibility="{Binding HasSelectedUser, Converter={StaticResource BoolToVisibility}}" />
                    <ContentControl Grid.Column="1" Content="{Binding SelectedUser}" ContentTemplate="{StaticResource UserTemplate}"
                                    VerticalAlignment="Center" Focusable="False" />
                    <Button Style="{StaticResource PrimaryButton}" Grid.Column="2" Content="בחר משתמש" Padding="12,3" Command="{Binding SelectUserCommand}"
                            ToolTip="בחירת המשתמש המסומן בטבלה (אפשר גם ללחוץ פעמיים על השורה)" />
                </Grid>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource DangerButton}" Content="בקשה חדשה" Padding="12,4" Command="{Binding NewRequestCommand}"
                    ToolTip="ניקוי הנתונים והתחלה מחדש" />
            <Button Style="{StaticResource PrimaryButton}" Grid.Column="2" Content="תצוגה מקדימה" Padding="16,4" Command="{Binding PreviewEmailCommand}"
                    ToolTip="הצגת ההודעה לבדיקה לפני פתיחתה ב-Outlook" />
        </Grid>

        <StatusBar Grid.Row="3">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StatusBar>
    </Grid>
</Window>
