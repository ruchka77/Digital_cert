<Window x:Class="DigitalCertHelper.Views.EmailPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="תצוגה מקדימה של ההודעה"
        Width="640" Height="520" MinWidth="520" MinHeight="440"
        FlowDirection="RightToLeft" xml:lang="he-IL"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
    </Window.InputBindings>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="פרטי ההודעה" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="נמען:" Margin="0,0,10,6" />
                <TextBox Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FlowDirection="LeftToRight" TextAlignment="Right" Margin="0,0,0,6"
                         Text="{Binding Draft.Recipient, Mode=OneWay}" AutomationProperties.Name="נמען" />
                <TextBlock Grid.Row="1" Text="נושא:" Margin="0,0,10,6" />
                <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="{Binding Draft.Subject, Mode=OneWay}" AutomationProperties.Name="נושא" />
                <TextBlock Grid.Row="2" Text="תוכן ההודעה:" Margin="0,0,10,6" />
                <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" Padding="6" Margin="0,0,0,6"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Draft.Body, Mode=OneWay}" AutomationProperties.Name="תוכן ההודעה" />
                <TextBlock Grid.Row="3" Text="קובץ מצורף:" Margin="0,0,10,0" />
                <TextBox Grid.Row="3" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FlowDirection="LeftToRight" TextAlignment="Right" TextWrapping="Wrap"
                         Text="{Binding Draft.Attachment.FullPath, Mode=OneWay}" AutomationProperties.Name="קובץ מצורף" />
                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding Draft.Attachment.MayContainPrivateKey, Converter={StaticResource BoolToVisibility}}"
                           Text="אזהרה: הקובץ המצורף עשוי להכיל מפתח פרטי. ודא שמותר לשלוח אותו בדואר אלקטרוני." />
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="1" Margin="0,8,0,8" TextWrapping="Wrap" FontWeight="Bold"
                   Text="היישום אינו שולח דואר. לחיצה על 'פתח הודעת דואר חדשה' תפתח הודעה חדשה ב-Outlook. בדוק את ההודעה, ואם הכול תקין לחץ בעצמך על 'שלח' ב-Outlook." />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource DangerButton}" Content="חזרה" Padding="16,4" Command="{Binding BackCommand}"
                    ToolTip="חזרה למסך הראשי כדי לתקן פרטים" />
            <Button Style="{StaticResource PrimaryButton}" Grid.Column="2" Content="פתח הודעת דואר חדשה" Padding="16,4"
                    Command="{Binding CreateOutlookDraftCommand}"
                    ToolTip="פותח הודעה חדשה ב-Outlook לבדיקה. ההודעה אינה נשלחת אוטומטית." />
        </Grid>
    </Grid>
</Window>
