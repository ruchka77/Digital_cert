<Window x:Class="DigitalCertHelper.Views.EmailPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Email Preview" Width="680" Height="520" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F2F4F7" FontFamily="Segoe UI" FontSize="13">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
    </Window.InputBindings>
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button Content="Back" Command="{Binding BackCommand}" />
            <Button DockPanel.Dock="Right" Content="Create Outlook Draft" Style="{StaticResource PrimaryButton}"
                    Command="{Binding CreateOutlookDraftCommand}" />
            <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="110" Height="12" Margin="0,0,16,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Recipient" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Column="1" Style="{StaticResource ReadOnlyField}" AutomationProperties.Name="Recipient"
                         Text="{Binding Draft.Recipient, Mode=OneWay}" />
                <TextBlock Grid.Row="1" Text="Subject" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ReadOnlyField}" FlowDirection="RightToLeft"
                         AutomationProperties.Name="Subject" Text="{Binding Draft.Subject, Mode=OneWay}" />
                <TextBlock Grid.Row="2" Text="Body" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" FlowDirection="RightToLeft"
                         VerticalScrollBarVisibility="Auto" Padding="10" Margin="0,0,0,10" FontSize="14"
                         AutomationProperties.Name="Email body" Text="{Binding Draft.Body, Mode=OneWay}" />
                <TextBlock Grid.Row="3" Text="Attachment" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ReadOnlyField}"
                         AutomationProperties.Name="Attachment"
                         Text="{Binding Draft.Attachment.FullPath, Mode=OneWay}" />
                <Border Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource WarningPanel}"
                        Visibility="{Binding Draft.Attachment.MayContainPrivateKey, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap"
                               Text="Warning: the attachment may contain a private key. Make sure it is approved for sending by email." />
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</Window>
